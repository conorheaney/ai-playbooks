  // Permission actions are allow | ask | deny. For pattern maps, the last matching rule wins.
  // "permission": {
  //   "read": "allow",
  //   "edit": "ask",
  //   "glob": "allow",
  //   "grep": "allow",
  //   "list": "allow",
